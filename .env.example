POSTGRES_USER=
POSTGRES_PASSWORD=

FHIR_USERNAME=
FHIR_PASSWORD=

# Optional: point fhir-catalogue-api at a remote FHIR server instead of the
# local hapi-fhir container. Leave unset to use the local stack.
CATALOGUE_FHIR_BASE_URL=
CATALOGUE_FHIR_USERNAME=
CATALOGUE_FHIR_PASSWORD=

# Secret for hashing PM-JAY IDs in anonymize_fhir_bundles.py. Keep it stable
# across runs (same key = same hashes) and never commit it.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
PII_HMAC_KEY=
